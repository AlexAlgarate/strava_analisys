[importlinter]
root_package = src
include_external_packages = False

[importlinter:contract:presentation_layers]
name = presentation -> application -> domain
type = layers
layers =
    presentation
    application
    domain
containers =
    src
exhaustive = false

[importlinter:contract:infrastructure_layers]
name = infrastructure -> application -> domain
type = layers
layers =
    infrastructure
    application
    domain
containers =
    src
exhaustive = false

[importlinter:contract:adapter_independence]
name = presentation and infrastructure adapters are independent
type = independence
modules =
    src.presentation
    src.infrastructure

[importlinter:contract:domain_independence]
name = domain does not depend on outer layers
type = forbidden
source_modules =
    src.domain
forbidden_modules =
    src.application
    src.infrastructure
    src.presentation
    src.composition

[importlinter:contract:composition_is_outermost]
name = inner layers do not depend on composition
type = forbidden
source_modules =
    src.domain
    src.application
    src.infrastructure
    src.presentation
forbidden_modules =
    src.composition
